<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8" />
  <title><%= title || 'Raport JOIN' %></title>
  <link rel="stylesheet" href="/resurse/CSS/general.css" />
  <style>
    :root{
      --bg:#f8f3ef; --paper:#fff; --ink:#2b2b2b; --muted:#7a6b62; --accent:#7b4c36;
      --line:#e9ddd4;
    }
    body{background:var(--bg); color:var(--ink);}
    .container{max-width:1100px; margin:24px auto 48px; padding:0 16px;}
    header h1{font-weight:700; text-align:center; margin:0 0 18px;}
    .meta{ text-align:center; color:var(--muted); margin:6px 0 18px;}
    /* FILTRE */
    .filters{
      display:flex; flex-wrap:wrap; gap:12px; justify-content:center; align-items:flex-end;
      margin:0 auto 18px; max-width:900px;
    }
    .filters label{display:flex; flex-direction:column; gap:6px; font-size:.95rem;}
    .filters input{padding:8px 10px; border:1px solid var(--line); border-radius:8px; background:#fff;}
    .btn{padding:10px 14px; border-radius:8px; border:0; cursor:pointer}
    .btn-primary{background:var(--accent); color:#fff}
    .btn-ghost{background:#eee; color:#333; text-decoration:none; display:inline-block; line-height:38px; padding:0 14px; border-radius:8px}
    /* TABEL */
    .table-wrap{
      background:var(--paper); border:1px solid var(--line); border-radius:12px;
      overflow:hidden; margin:0 auto; max-width:100%;
      box-shadow: 0 2px 8px rgba(0,0,0,.03);
    }
    table{width:100%; border-collapse:collapse;}
    thead th{background:#efe1d8; font-size:.9rem; letter-spacing:.02em;}
    th,td{padding:12px 10px; border-bottom:1px solid var(--line); text-align:center; vertical-align:top;}
    tbody tr.group-sep td{background:#faf6f3; border-top:2px solid var(--line); font-weight:600}
    tfoot td{background:#faf6f3; font-weight:700}
    .badge{display:inline-block; padding:.25rem .6rem; background:#e9dccf; border-radius:999px; font-size:.8rem}
    .empty{padding:24px; text-align:center; background:var(--paper); border:1px dashed var(--line); border-radius:12px}
    @media (max-width: 720px){
      .filters{gap:10px}
      th,td{padding:10px 8px; font-size:.95rem}
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>Raport JOIN (≥3 tabele, ≥2 condiții)</h1>
    </header>


    <form method="get" action="/rapoarte/joins" class="filters">
      <label>
        de la
        <input type="date" name="date_from" value="<%= date_from || '' %>">
      </label>
      <label>
        până la
        <input type="date" name="date_to" value="<%= date_to || '' %>">
      </label>
      <label>
        preț minim produs
        <input type="number" step="0.01" min="0" name="min_pret" value="<%= (typeof min_pret!=='undefined' && min_pret!==null)?min_pret:'' %>">
      </label>
      <button type="submit" class="btn btn-primary"> Filtreaza</button>
      <a class="btn-ghost" href="/rapoarte/joins">Reseteaza</a>
    </form>

    <div class="meta">
      <span class="badge">rezultate: <strong><%= (rows && rows.length) ? rows.length : 0 %></strong></span>
      <% if (date_from || date_to) { %>
        · interval: <%= date_from || '—' %> → <%= date_to || '—' %>
      <% } %>
      <% if (min_pret) { %>
        · preț ≥ <%= Number(min_pret).toLocaleString('ro-RO',{minimumFractionDigits:2, maximumFractionDigits:2}) %> RON
      <% } %>
    </div>

    <% if (rows && rows.length) { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>COMANDĂ</th>
              <th>DATA</th>
              <th>CLIENT</th>
              <th>PRODUS</th>
              <th>CANT</th>
              <th>PREȚ</th>
              <th>SUBTOTAL</th>
            </tr>
          </thead>
          <tbody>
            <% 
              let lastId = null;
              let totalComanda = 0;
              const fmtDate = d => { try{ const dt = new Date(d); return dt.toLocaleDateString('ro-RO',{day:'2-digit',month:'short',year:'numeric'}); } catch{ return d; } };
              const fmtMoney = v => Number(v||0).toLocaleString('ro-RO',{minimumFractionDigits:2, maximumFractionDigits:2});
              rows.forEach((r, idx) => {
                if (lastId !== null && r.id_comanda !== lastId) {
            %>
              <tr class="group-sep">
                <td colspan="6" style="text-align:right;">Total comandă #<%= lastId %></td>
                <td><%= fmtMoney(totalComanda) %> RON</td>
              </tr>
            <% 
                  totalComanda = 0;
                }
                lastId = r.id_comanda;
                totalComanda += Number(r.subtotal||0);
            %>
              <tr>
                <td>#<%= r.id_comanda %></td>
                <td><%= fmtDate(r.data_comanda) %></td>
                <td><%= r.client %></td>
                <td><%= r.produs %></td>
                <td><%= r.cantitate %></td>
                <td><%= fmtMoney(r.pret) %></td>
                <td><%= fmtMoney(r.subtotal) %></td>
              </tr>
            <% if (idx === rows.length - 1) { %>
              <tr class="group-sep">
                <td colspan="6" style="text-align:right;">Total comandă #<%= r.id_comanda %></td>
                <td><%= fmtMoney(totalComanda) %> RON</td>
              </tr>
            <% } }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty">
        <h3>Nu s-au găsit rezultate pentru filtrele alese.</h3>
        <p>Modifică intervalul sau prețul minim și caută din nou.</p>
      </div>
    <% } %>
  </div>
</body>
</html>

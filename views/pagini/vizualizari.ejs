<!DOCTYPE html>
<html lang="ro">
<head><meta charset="UTF-8"><title><%= title %></title>
<link rel="stylesheet" href="/resurse/CSS/general.css">
<style>table{width:100%;border-collapse:collapse}th,td{padding:6px;border-bottom:1px solid #eee}</style>
</head>
<body>
<header><h1>Vizualizari</h1></header>
<main>
  <section>
    <h2>v_produs_simplu (updatabil)</h2>
    <table>
      <thead><tr><th>id</th><th>nume</th><th>pret</th><th>stoc</th><th>modifica</th></tr></thead>
      <tbody>
        <% (v1||[]).forEach(r=>{ %>
          <tr>
            <td><%= r.id_produs %></td>
            <td><%= r.nume %></td>
            <td><%= r.pret %></td>
            <td><%= r.stoc %></td>
            <td>
              <form method="post" action="/vizualizari/produs/update" style="display:flex;gap:6px">
                <input type="hidden" name="id_produs" value="<%= r.id_produs %>">
                <input type="number" step="0.01" name="pret" value="<%= r.pret %>" required>
                <input type="number" name="stoc" value="<%= r.stoc %>" required>
                <button>salveaza</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>

  <section>
    <h2>v_raport_vanzari_clienti (complex, read only)</h2>
    <table>
      <thead><tr><th>client</th><th>nr comenzi</th><th>nr produse</th><th>total</th></tr></thead>
      <tbody>
        <% (v2||[]).forEach(r=>{ %>
          <tr>
            <td>#<%= r.id_client %> — <%= r.nume %> <%= r.prenume %></td>
            <td><%= r.nr_comenzi %></td>
            <td><%= r.nr_produse %></td>
            <td><%= r.total_valoare %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
</main>
</body>
</html>

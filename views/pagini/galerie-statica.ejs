<style>
  .galerie-grid.layout-obligatoriu {
    grid-template-columns: repeat(4, 1fr) !important;
  }
</style>

<section class="galerie-statica" id="galerie-statica-section">
    <h2>
        <i class="fa-solid fa-images"></i>
        Galeria Noastră de Artă
    </h2>
    
    <% if (galerieData && galerieData.imagini && galerieData.imagini.length > 0) { %>
        <!-- Grid pentru imagini -->
        <div class="galerie-grid">
            <% galerieData.imagini.forEach((imagine, index) => { %>
                <div class="galerie-item" 
                     data-titlu="<%= imagine.titlu %>" 
                     data-interval="<%= imagine.timp %>">
                    
                    <figure>
                        <picture>
                            <source media="(max-width: 768px)" 
                                    srcset="<%= galerieData.cale_galerie %>small/<%= imagine.cale_imagine %>">
                            <source media="(max-width: 1024px)" 
                                    srcset="<%= galerieData.cale_galerie %>medium/<%= imagine.cale_imagine %>">
                            
                            <img src="<%= galerieData.cale_galerie %><%= imagine.cale_imagine %>" 
                                 alt="<%= imagine.alt || imagine.titlu %>"
                                 title="<%= imagine.descriere %>"
                                 loading="lazy">
                        </picture>
                        
                        <figcaption>
                            <%= imagine.descriere %>
                        </figcaption>
                        
                        <% if (imagine.atribuire) { %>
                            <div class="atribuire-info" title="<%= imagine.atribuire.licenta %> - <%= imagine.atribuire.autor %>">
                                © <%= imagine.atribuire.autor %>
                            </div>
                        <% } %>
                    </figure>
                </div>
            <% }); %>
        </div>
        
        <div class="galerie-info">
            <p>
                <i class="fa-solid fa-clock"></i>
                <span class="ora-curenta">Ora curentă: <%= oraAfisare %></span>
            </p>
            <p>
                <i class="fa-solid fa-filter"></i>
                Afișăm <%= galerieData.imagini.length %> imagini disponibile în acest interval de timp
            </p>
            <% if (galerieData.totalImagini && galerieData.totalImagini > galerieData.imagini.length) { %>
                <p>
                    <i class="fa-solid fa-info-circle"></i>
                    Total imagini în galerie: <%= galerieData.totalImagini %>
                </p>
            <% } %>
        </div>
        
    <% } else { %>
        <div class="galerie-eroare">
            <h3>
                <i class="fa-solid fa-exclamation-triangle"></i>
                Nu sunt imagini disponibile
            </h3>
            <p>
                În acest moment (ora <%= oraAfisare %>), nu există imagini programate pentru afișare în galerie.
            </p>
            <p>
                <small>Reveniți mai târziu pentru a vedea opere de artă noi!</small>
            </p>
        </div>
    <% } %>
</section>

<link rel="stylesheet" href="/resurse/CSS/galerie-statica.css">
<%- include('../fragmente/galerie_statica', { galerieData: galerieData, oraAfisare: oraAfisare }) %>

<script>
document.addEventListener('DOMContentLoaded', function() {
    console.log('Inițializare galerie statică...');
    
    const galerieItems = document.querySelectorAll('.galerie-item');
    
    galerieItems.forEach((item, index) => {
        
        item.style.animationDelay = `${index * 0.1}s`;
        
        item.addEventListener('mouseenter', function() {
            const titlu = this.dataset.titlu;
            const interval = this.dataset.interval;
            console.log(`Hover pe: ${titlu} (${interval})`);
        });
        
        item.addEventListener('click', function() {
            const titlu = this.dataset.titlu;
            const descriere = this.querySelector('figcaption').textContent.replace(/^[a-z]\.\s/, '');
            
            console.log(`Click pe imagine: ${titlu}`);
            console.log(`Descriere: ${descriere}`);
        });
    });

    
    console.log(`Galerie facuta  cu ${galerieItems.length} imagini`);
    
    galerieItems.forEach(item => {
        const interval = item.dataset.interval;
        console.log(`Imagine afis în intervalul: ${interval}`);
    });
});
</script>
<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <title><%= title || 'Admin DB' %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="bg-dark text-light">
<div class="container-fluid py-4">
  <div class="d-flex align-items-center justify-content-between">
    <h2 class="mb-3">Admin DB</h2>
    <small>IP: <%= ipUtilizator %></small>
  </div>

  <div class="row">
    <aside class="col-12 col-md-3 mb-3">
      <div class="card bg-secondary">
        <div class="card-body">
          <h5 class="card-title">Tabele</h5>
          <div class="list-group">
            <% (tables || []).forEach(function(t){ %>
              <a class="list-group-item list-group-item-action <%= (t===active)?'active':'' %>"
                 href="/admin/db?t=<%= encodeURIComponent(t) %>">
                <%= t %>
              </a>
            <% }) %>
          </div>
          <hr>
          <h6>Consolă (SELECT-only)</h6>
          <form id="sqlForm" class="mt-2">
            <textarea class="form-control mb-2" name="sql" rows="4" placeholder="SELECT * FROM <%= active || (tables&&tables[0]) || 'tabel' %> LIMIT 10;"></textarea>
            <button class="btn btn-light w-100" type="submit">Rulează</button>
          </form>
          <div id="sqlOut" class="mt-2"></div>
        </div>
      </div>
    </aside>

    <main class="col-12 col-md-9">
      <div class="d-flex align-items-center justify-content-between">
        <h4 class="mb-3">Tabel: <code><%= active || '-' %></code></h4>
        <form class="d-flex gap-2" method="get" action="/admin/db">
          <input type="hidden" name="t" value="<%= active %>">
          <select class="form-select form-select-sm" name="limit" onchange="this.form.submit()">
            <% [10,20,50,100].forEach(function(n){ %>
              <option value="<%= n %>" <%= (n===(limit||20))?'selected':'' %>><%= n %>/pag</option>
            <% }) %>
          </select>
        </form>
      </div>

      <% if ((cols||[]).length) { %>
        <div class="table-responsive">
          <table class="table table-dark table-striped align-middle">
            <thead>
              <tr>
                <% cols.forEach(function(c){ %>
                  <th>
                    <a class="link-light"
                       href="/admin/db?t=<%= encodeURIComponent(active) %>&sort=<%= c.column_name %>&dir=<%= (dir==='desc')?'asc':'desc' %>">
                      <%= c.column_name %>
                    </a>
                    <div class="small text-muted"><%= c.data_type %></div>
                  </th>
                <% }) %>
              </tr>
            </thead>
            <tbody>
              <% (rows||[]).forEach(function(r){ %>
                <tr>
                  <% cols.forEach(function(c){ %>
                    <td style="max-width:420px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"
                        title="<%= r[c.column_name] %>">
                      <%= (r[c.column_name]===null || typeof r[c.column_name]==='undefined') ? '—' : r[c.column_name] %>
                    </td>
                  <% }) %>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <% const totalPages = Math.max(1, Math.ceil((total||0) / (limit||20))); %>
        <nav>
          <ul class="pagination">
            <% for (let i=1;i<=totalPages;i++){ %>
              <li class="page-item <%= (i===(page||1))?'active':'' %>">
                <a class="page-link" href="/admin/db?t=<%= encodeURIComponent(active) %>&page=<%= i %>&limit=<%= limit||20 %>"><%= i %></a>
              </li>
            <% } %>
          </ul>
        </nav>
      <% } else { %>
        <div class="alert alert-warning">Nu s-au găsit coloane sau rânduri pentru tabelul selectat.</div>
      <% } %>
    </main>
  </div>
</div>

<script>
  const form = document.getElementById('sqlForm');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const res = await fetch('/admin/query', {
      method: 'POST',
      headers: {'Content-Type':'application/x-www-form-urlencoded'},
      body: new URLSearchParams(Array.from(fd.entries()))
    });
    const json = await res.json();
    const out = document.getElementById('sqlOut');
    if (!json.ok) { out.innerHTML = '<div class="text-danger">'+json.error+'</div>'; return; }
    if (!json.rows.length) { out.innerHTML = '<div class="text-muted">(0 rânduri)</div>'; return; }
    const cols = Object.keys(json.rows[0]);
    const html = `
      <div class="table-responsive mt-2">
        <table class="table table-dark table-striped table-sm">
          <thead><tr>${cols.map(c=>`<th>${c}</th>`).join('')}</tr></thead>
          <tbody>
            ${json.rows.map(r=>`<tr>${cols.map(c=>`<td>${(r[c]==null)?'—':r[c]}</td>`).join('')}</tr>`).join('')}
          </tbody>
        </table>
      </div>`;
    out.innerHTML = html;
  });
</script>
</body>
</html>

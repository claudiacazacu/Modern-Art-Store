<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <title><%= title || 'Admin DB' %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="bg-dark text-light">
<div class="container-fluid py-4">

  <!-- header + nav -->
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div class="d-flex align-items-center gap-3">
      <h2 class="mb-0">Admin DB</h2>
      <% if (typeof active !== 'undefined' && active) { %>
        <span class="badge text-bg-secondary">tabel: <code><%= active %></code></span>
      <% } %>
      <% if (typeof total !== 'undefined' && total !== null) { %>
        <span class="badge text-bg-info">total randuri: <%= total %></span>
      <% } %>
    </div>
    <small>IP: <%= ipUtilizator %></small>
  </div>

  <nav class="mb-4">
    <div class="btn-group btn-group-sm" role="group" aria-label="nav admin">
      <a class="btn btn-outline-light" href="/admin/db">Admin DB</a>
      <a class="btn btn-outline-light" href="/admin/produse">Admin produse</a>
      <a class="btn btn-outline-light" href="/rapoarte/joins">Raport JOIN</a>
      <a class="btn btn-outline-light" href="/rapoarte/having">Raport HAVING</a>
      <a class="btn btn-outline-light" href="/vizualizari">Vizualizari</a>
      <a class="btn btn-outline-light" href="/admin/comenzi">Cascade demo</a>
    </div>
  </nav>

  <div class="row">
    <!-- sidebar: tabele + consola -->
    <aside class="col-12 col-md-3 mb-3">
      <div class="card bg-secondary h-100">
        <div class="card-body">
          <h5 class="card-title">Tabele</h5>
          <div class="list-group">
            <% (tables || []).forEach(function(t){ %>
              <a class="list-group-item list-group-item-action <%= (t===active)?'active':'' %>"
                 href="/admin/db?t=<%= encodeURIComponent(t) %>">
                <%= t %>
              </a>
            <% }) %>
          </div>
          <hr>
          <h6>Consola (SELECT-only)</h6>
          <form id="sqlForm" class="mt-2">
            <textarea class="form-control mb-2" name="sql" rows="4" placeholder="SELECT * FROM <%= active || (tables&&tables[0]) || 'tabel' %> LIMIT 10;"></textarea>
            <button class="btn btn-light w-100" type="submit">Ruleaza</button>
          </form>
          <div id="sqlOut" class="mt-2 small"></div>
        </div>
      </div>
    </aside>

    <!-- main: lista + sort + paginare -->
    <main class="col-12 col-md-9">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h4 class="mb-0">Tabel: <code><%= active || '-' %></code></h4>

        <form class="d-flex gap-2 align-items-center" method="get" action="/admin/db">
          <input type="hidden" name="t" value="<%= active || '' %>">
          <input type="hidden" name="sort" value="<%= (typeof sort!=='undefined' ? sort : '') %>">
          <input type="hidden" name="dir" value="<%= dir || 'asc' %>">
          <label class="form-label m-0 small">Randuri/pagina</label>
          <select class="form-select form-select-sm" name="limit" onchange="this.form.submit()">
            <% [10,20,50,100].forEach(function(n){ %>
              <option value="<%= n %>" <%= (n===(limit||20))?'selected':'' %>><%= n %>/pag</option>
            <% }) %>
          </select>
        </form>
      </div>

      <hr class="border-secondary">

      <% if ((cols||[]).length) { %>
        <div class="table-responsive">
          <table class="table table-dark table-striped align-middle">
            <thead>
              <tr>
                <% cols.forEach(function(c){ 
                     const isSorted = (typeof sort!=='undefined' && sort === c.column_name);
                     const newDir = isSorted ? ((dir==='asc') ? 'desc' : 'asc') : 'asc';
                %>
                  <th class="text-nowrap">
                    <a class="link-light"
                       href="/admin/db?t=<%= encodeURIComponent(active) %>&sort=<%= c.column_name %>&dir=<%= newDir %>&limit=<%= limit||20 %>&page=1">
                      <%= c.column_name %>
                      <% if (isSorted) { %>
                        <span class="ms-1"><%= (dir==='asc') ? '▲' : '▼' %></span>
                      <% } %>
                    </a>
                    <div class="small text-muted"><%= c.data_type %></div>
                  </th>
                <% }) %>
              </tr>
            </thead>
            <tbody>
              <% (rows||[]).forEach(function(r){ %>
                <tr>
                  <% cols.forEach(function(c){ %>
                    <td style="max-width:420px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"
                        title="<%= r[c.column_name] %>">
                      <%= (r[c.column_name]===null || typeof r[c.column_name]==='undefined') ? '—' : r[c.column_name] %>
                    </td>
                  <% }) %>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <% 
          const perPage = (limit||20);
          const totalRows = (typeof total!=='undefined' && total!=null) ? total : 0;
          const totalPages = Math.max(1, Math.ceil(totalRows / perPage));
          const currPage = (page||1);
        %>
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
          <div class="small text-muted">Total: <strong><%= totalRows %></strong> · Pagina <strong><%= currPage %></strong> / <strong><%= totalPages %></strong></div>
          <nav>
            <ul class="pagination pagination-sm mb-0">
              <% for (let i=1;i<=totalPages;i++){ %>
                <li class="page-item <%= (i===currPage)?'active':'' %>">
                  <a class="page-link" href="/admin/db?t=<%= encodeURIComponent(active) %>&page=<%= i %>&limit=<%= perPage %>&sort=<%= (typeof sort!=='undefined'?sort:'') %>&dir=<%= dir||'asc' %>"><%= i %></a>
                </li>
              <% } %>
            </ul>
          </nav>
        </div>
      <% } else { %>
        <div class="alert alert-warning">Nu s-au gasit coloane sau randuri pentru tabelul selectat.</div>
      <% } %>
    </main>
  </div>
</div>

<script>
  const form = document.getElementById('sqlForm');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const res = await fetch('/admin/query', {
      method: 'POST',
      headers: {'Content-Type':'application/x-www-form-urlencoded'},
      body: new URLSearchParams(Array.from(fd.entries()))
    });
    const json = await res.json();
    const out = document.getElementById('sqlOut');
    if (!json.ok) { out.innerHTML = '<div class="text-danger">'+json.error+'</div>'; return; }
    if (!json.rows.length) { out.innerHTML = '<div class="text-muted">(0 randuri)</div>'; return; }
    const cols = Object.keys(json.rows[0]);
    const html = `
      <div class="table-responsive mt-2">
        <table class="table table-dark table-striped table-sm">
          <thead><tr>${cols.map(c=>`<th>${c}</th>`).join('')}</tr></thead>
          <tbody>
            ${json.rows.map(r=>`<tr>${cols.map(c=>`<td>${(r[c]==null)?'—':r[c]}</td>`).join('')}</tr>`).join('')}
          </tbody>
        </table>
      </div>`;
    out.innerHTML = html;
  });
</script>
</body>
</html>

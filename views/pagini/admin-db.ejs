<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8" />
  <title><%= title || 'Admin DB' %></title>
  <link rel="stylesheet" href="/resurse/CSS/general.css" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <style>
    :root{
      --bg:#f8f3ef; --paper:#fff; --ink:#2b2b2b; --muted:#7a6b62; --accent:#7b4c36;
      --line:#e9ddd4; --chip:#efe1d8; --badge:#e9dccf;
    }
    
    body{background:var(--bg); color:var(--ink); margin:0;}
    .container{max-width:1200px; margin:24px auto 48px; padding:0 16px; display:grid; grid-template-columns: 240px 1fr; gap:18px;}
    header{grid-column:1 / -1;}
    header h1{font-weight:700; text-align:center; margin:0 0 4px;}
    .meta{ text-align:center; color:var(--muted); }

    
    .nav-admin{grid-column:1 / -1; display:flex; flex-wrap:wrap; gap:10px; justify-content:center; margin-bottom:6px;}
    .nav-admin a{padding:10px 14px; border-radius:8px; background:var(--accent); color:#fff; text-decoration:none}
    .nav-admin a:hover{background:#5d3324;}

    
    .card{
      background:var(--paper); border:1px solid var(--line); border-radius:12px;
      box-shadow: 0 2px 8px rgba(0,0,0,.03);
    }
    
    aside .card{ position:sticky; top:18px; }
    .section-title{font-size:1rem; font-weight:700; padding:14px 14px 0;}
    .list{
      list-style:none; margin:10px 0 14px; padding:0 10px 10px; max-height:50vh; overflow:auto;
    }
    .list a{
      display:block; padding:8px 10px; margin:6px 0; border:1px solid var(--line); border-radius:8px;
      text-decoration:none; color:var(--ink); background:#fff;
    }
    .list a.active{ background:var(--chip); border-color:#e2cfc0; font-weight:600; }
    .kvs{ display:flex; gap:10px; align-items:center; justify-content:space-between; padding:0 14px 14px; color:var(--muted); }


    .btn{padding:10px 14px; border-radius:8px; border:0; cursor:pointer}
    .btn-primary{background:var(--accent); color:#fff}
    .btn-ghost{background:#eee; color:#333; text-decoration:none; display:inline-block; line-height:38px; padding:0 14px; border-radius:8px}
    .input, textarea{
      width:100%; box-sizing:border-box; padding:10px 12px; border:1px solid var(--line); border-radius:10px; background:#fff; color:var(--ink);
    }


    .toolbar{display:flex; flex-wrap:wrap; gap:10px; align-items:center; justify-content:space-between; padding:14px; border-bottom:1px solid var(--line);}
    .crumb{color:var(--muted);}
    .badge{display:inline-block; padding:.25rem .6rem; background:var(--badge); border-radius:999px; font-size:.8rem}
    .paper{padding:0;}


    .table-wrap{ margin:14px; border:1px solid var(--line); border-radius:12px; overflow:auto; }
    table{width:100%; border-collapse:collapse; background:#fff;}
    thead th{background:#efe1d8; font-size:.9rem; letter-spacing:.02em; position:sticky; top:0; z-index:1;}
    th,td{padding:12px 10px; border-bottom:1px solid var(--line); text-align:center; vertical-align:middle;}
    th a{ color:inherit; text-decoration:none; display:inline-flex; align-items:center; gap:6px; }
    th .arrow{font-size:.9em; color:var(--muted)}
    .empty{padding:28px; text-align:center;}


    .pager{
      padding:12px 14px; display:flex; align-items:center; justify-content:center; gap:6px; border-top:1px solid var(--line); background:#faf7f4; border-radius:0 0 12px 12px;
      flex-wrap:wrap;
    }
    .page{
      display:inline-block; min-width:36px; text-align:center; line-height:34px; padding:0 10px; border:1px solid var(--line); border-radius:8px; background:#fff; text-decoration:none; color:var(--ink);
    }
    .page.active{ background:var(--accent); color:#fff; border-color:var(--accent); }


    details.sql { margin:14px; border:1px dashed var(--line); border-radius:12px; background:#fff; }
    details.sql summary{ cursor:pointer; padding:12px 14px; font-weight:600; }
    .sql-body{ padding:0 14px 14px; display:grid; gap:10px; }
    .sql-out{ border:1px solid var(--line); border-radius:10px; overflow:auto; }
    .sql-out table{ background:#fff; }


    @media (max-width: 900px){ .container{ grid-template-columns: 1fr; } aside .card{ position:static; } }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>Admin DB</h1>
      <div class="meta">
        <span class="badge">total rânduri: <%= (typeof total!=='undefined' && total!=null)? total : 0 %></span>
        · IP: <%= ipUtilizator %>
      </div>
    </header>

    
    <nav class="nav-admin">
      <a href="/admin/db"> Admin DB</a>
      <a href="/admin/produse"> Admin Produse</a>
      <a href="/rapoarte/joins"> Raport JOIN</a>
      <a href="/rapoarte/having"> Raport HAVING</a>
      <a href="/vizualizari"> Vizualizări</a>
      <a href="/admin/comenzi"> Cascade Demo</a>
    </nav>

    
    <aside>
      <div class="card">
        <div class="section-title">Tabele</div>
        <ul class="list">
          <% (tables || [])
              .filter(t => String(t).toLowerCase() !== 'artist') /* opțional: ascunde „artist” */
              .forEach(function(t){ %>
            <li>
              <a class="<%= (t===active)?'active':'' %>" href="/admin/db?t=<%= encodeURIComponent(t) %>">
                <%= t %>
              </a>
            </li>
          <% }) %>
        </ul>
        <div class="kvs">
          <span class="crumb">tabel curent:</span>
          <strong><%= active || '—' %></strong>
        </div>
      </div>
    </aside>

    
    <main>
      <div class="card paper">
        <div class="toolbar">
          <div class="crumb">/ admin / db / <strong><%= active || '—' %></strong></div>
          <div class="badges">
            <% if (typeof limit!=='undefined' && limit){ %>
              <span class="badge">/pag: <%= limit %></span>
            <% } %>
            <% if (typeof sort!=='undefined' && sort){ %>
              <span class="badge">sort: <%= sort %> <%= (dir==='desc'?'↓':'↑') %></span>
            <% } %>
          </div>
        </div>

        <% if ((cols||[]).length && (rows||[]).length) { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <% cols.forEach(function(c){
                      const isSorted = (typeof sort!=='undefined' && sort === c.column_name);
                      const newDir = isSorted ? ((dir==='asc') ? 'desc' : 'asc') : 'asc';
                  %>
                    <th>
                      <a href="/admin/db?t=<%= encodeURIComponent(active) %>&sort=<%= c.column_name %>&dir=<%= newDir %>&limit=<%= limit||20 %>&page=1">
                        <span><%= c.column_name %></span>
                        <% if (isSorted) { %><span class="arrow"><%= (dir==='asc') ? '↑' : '↓' %></span><% } %>
                      </a>
                    </th>
                  <% }) %>
                </tr>
              </thead>
              <tbody>
                <% rows.forEach(function(r){ %>
                  <tr>
                    <% cols.forEach(function(c){ const val = r[c.column_name]; %>
                      <td title="<%= (val==null)?'—':val %>">
                        <%= (val==null)?'—':val %>
                      </td>
                    <% }) %>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <% 
            const perPage = (limit||20);
            const totalRows = (typeof total!=='undefined' && total!=null) ? total : rows.length;
            const totalPages = Math.max(1, Math.ceil(totalRows / perPage));
            const currPage = (page||1);
          %>
          <div class="pager">
            <% for (let i=1;i<=totalPages;i++){ %>
              <a class="page <%= (i===currPage)?'active':'' %>"
                 href="/admin/db?t=<%= encodeURIComponent(active) %>&page=<%= i %>&limit=<%= perPage %>&sort=<%= (typeof sort!=='undefined'?sort:'') %>&dir=<%= dir||'asc' %>"><%= i %></a>
            <% } %>
          </div>
        <% } else { %>
          <div class="empty">
            <h3>Nu s-au găsit date pentru tabelul selectat.</h3>
            <p>Încearcă să alegi un alt tabel din stânga sau să adaugi date.</p>
          </div>
        <% } %>


        <details class="sql" <%= (typeof sql_open!=='undefined' && sql_open)?'open':'' %>>
          <summary>Consolă SQL (doar SELECT)</summary>
          <div class="sql-body">
            <form id="sqlForm" method="post" action="/admin/query">
              <textarea class="input" name="sql" rows="5" placeholder="SELECT * FROM <%= active || (tables&&tables[0]) || 'tabel' %> LIMIT 10;"></textarea>
              <div style="display:flex; gap:10px; justify-content:flex-end;">
                <button type="submit" class="btn btn-primary">Rulează</button>
                <button type="button" class="btn btn-ghost" id="sqlClear">Curăță</button>
              </div>
            </form>
            <div id="sqlOut" class="sql-out"></div>
          </div>
        </details>
      </div>
    </main>
  </div>

  <script>
    
    const form = document.getElementById('sqlForm');
    const out = document.getElementById('sqlOut');
    const btnClear = document.getElementById('sqlClear');

    btnClear?.addEventListener('click', () => { out.innerHTML = ''; form?.reset(); });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const res = await fetch('/admin/query', {
        method: 'POST',
        headers: {'Content-Type':'application/x-www-form-urlencoded'},
        body: new URLSearchParams(Array.from(fd.entries()))
      });
      let json;
      try{ json = await res.json(); }catch{ json = {ok:false,error:'Răspuns invalid'}; }
      if (!json.ok){
        out.innerHTML = '<div style="padding:12px; color:#b00020;">'+(json.error||'Eroare la rulare')+'</div>';
        return;
      }
      if (!json.rows || !json.rows.length){
        out.innerHTML = '<div style="padding:12px; color:var(--muted);">(0 rânduri)</div>';
        return;
      }
      const cols = Object.keys(json.rows[0]);
      const html = `
        <div style="overflow:auto;">
          <table style="width:100%; border-collapse:collapse; background:#fff;">
            <thead>
              <tr style="background:#efe1d8;">
                ${cols.map(c=>`<th style="padding:10px; border-bottom:1px solid var(--line); text-align:center;">${c}</th>`).join('')}
              </tr>
            </thead>
            <tbody>
              ${json.rows.map(r=>`<tr>${
                cols.map(c=>`<td style="padding:10px; border-bottom:1px solid var(--line); text-align:center;">${(r[c]==null)?'—':r[c]}</td>`).join('')
              }</tr>`).join('')}
            </tbody>
          </table>
        </div>`;
      out.innerHTML = html;
    });
  </script>
</body>
</html>
